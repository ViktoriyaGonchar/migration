# Корень репозитория (где лежат index.html и папка assets/)
SITE_ROOT=.

# SQLite (относительно cwd при запуске)
DATABASE_URL=sqlite+aiosqlite:///./app.db

# Секрет для хэширования login/session токенов (длинная случайная строка)
TOKEN_PEPPER=замените_на_случайную_строку_32plus

# Секрет сессии Starlette для SQLAdmin (отдельно от пользовательских сессий)
ADMIN_SESSION_SECRET=замените_на_другую_случайную_строку

# HttpOnly cookie пользователя: Secure=true только за HTTPS
COOKIE_SECURE=false

# Базовый URL для печати ссылки входа в CLI (без завершающего /)
BASE_URL=http://127.0.0.1:8000

# --- Phase 2B: internal API + Telegram-бот ---
# Общий секрет для заголовка X-Internal-Key (пусто = internal routes отвечают 503)
INTERNAL_API_KEY=

# Phase 9: после скольких часов (UTC) «самая старая pending» подсвечивается красным в админке (1–168)
STALE_PENDING_ALERT_HOURS=48

# Базовый URL FastAPI для httpx у бота (без завершающего /)
INTERNAL_API_BASE_URL=http://127.0.0.1:8000

# Токен бота от @BotFather
BOT_TOKEN=

# Phase 3: username бота без @ (обязателен для mc-cli issue-telegram-link)
BOT_USERNAME=

# --- Phase 5: ручная оплата переводом (только бот + учёт в БД) ---
# Реквизиты для показа в /pay (без автоподтверждения и провайдеров).
PAYMENT_CARD_NUMBER=
PAYMENT_RECIPIENT_NAME=
PAYMENT_BANK_NAME=
# Подпись суммы/тарифа (дублируется в snapshot заявки на бэкенде при PAYMENT_AMOUNT_LABEL в env приложения)
PAYMENT_AMOUNT_LABEL=
# Список chat_id админов через запятую; бот шлёт уведомление о новой заявке (админы должны /start боту или быть в группе с ботом).
ADMIN_NOTIFY_TELEGRAM_IDS=

# --- Phase 7: заглушки платёжных провайдеров (без реальных API) ---
# Показ /pay_methods в боте (тестовые payment_attempts; /pay не меняется).
PAYMENTS_STUBS_ENABLED=false
# Разрешить internal POST .../mock-confirm и .../mock-fail (внешне 404 если false).
PAYMENTS_SANDBOX_MODE=false
# SQLAdmin: страница mock confirm/fail (только вместе с PAYMENTS_SANDBOX_MODE).
PAYMENTS_MOCK_UI=false
# Заглушка базового URL для будущих callback (в metadata stub).
PAYMENTS_CALLBACK_BASE_URL=
# Плейсхолдеры на будущее (не обязательны в Phase 7).
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
