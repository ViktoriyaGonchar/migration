# =============================================================================
# .env.full.example — расширенный набор (НЕ для первого минимального запуска)
# =============================================================================
# Откуда брать и как генерировать ключи/секреты: START_HERE.md → «Где взять и как сгенерировать значения для .env».
# Для старта достаточно скопировать .env.example → .env. Этот файл — для
# production, ручной оплаты, уведомлений админам, sandbox/stub, привязки Telegram
# и локальных переопределений. Переносите в .env только нужные строки.

# =============================================================================
# Минимум (дублируется из .env.example; при полном файле раскомментируйте)
# =============================================================================
# TOKEN_PEPPER=
# ADMIN_SESSION_SECRET=
# BOT_TOKEN=
# INTERNAL_API_KEY=

# =============================================================================
# App / база / статика / сессии / internal
# =============================================================================
# SITE_ROOT=.
# DATABASE_URL=sqlite+aiosqlite:///./app.db
# COOKIE_SECURE=false
# BASE_URL=http://127.0.0.1:8000
# STALE_PENDING_ALERT_HOURS=48

# В Docker compose DATABASE_URL для app и migrate задаётся в docker-compose.yml —
# в .env дублировать не нужно.

# =============================================================================
# Bot — URL к app (локально; в Docker задаётся в compose для сервиса bot)
# =============================================================================
# INTERNAL_API_BASE_URL=http://127.0.0.1:8000

# =============================================================================
# Telegram — username (без @). НЕ обязателен для старта процесса бота.
# Нужен для mc-cli issue-telegram-link и deep link в админке (Operator).
# =============================================================================
# BOT_USERNAME=

# =============================================================================
# Prod / HTTPS
# =============================================================================
# COOKIE_SECURE=true
# BASE_URL=https://example.com

# =============================================================================
# Ручная оплата (реквизиты в /pay и snapshot заявки)
# =============================================================================
# PAYMENT_CARD_NUMBER=
# PAYMENT_RECIPIENT_NAME=
# PAYMENT_BANK_NAME=
# PAYMENT_AMOUNT_LABEL=

# =============================================================================
# Уведомления админам (chat_id через запятую)
# =============================================================================
# ADMIN_NOTIFY_TELEGRAM_IDS=

# =============================================================================
# Sandbox / заглушки провайдеров (на production обычно выключены)
# =============================================================================
# PAYMENTS_STUBS_ENABLED=false
# PAYMENTS_SANDBOX_MODE=false
# PAYMENTS_MOCK_UI=false
# PAYMENTS_CALLBACK_BASE_URL=

# =============================================================================
# YooKassa / будущие интеграции
# =============================================================================
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=
